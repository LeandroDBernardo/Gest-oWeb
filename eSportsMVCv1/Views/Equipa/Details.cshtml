@model eSportsMVCv1.Models.Equipa
@{ ViewData["Title"] = "Team details"; }
<h1>@Model.Nome</h1><dl class="row"><dt class="col-sm-2">Country</dt><dd class="col-sm-10">@Model.Pais</dd><dt class="col-sm-2">Manager</dt><dd class="col-sm-10">@Model.Gestor?.FullName</dd></dl><h2>Players</h2><ul>@foreach (var player in Model.Jogadores) { <li><a asp-controller="Jogador" asp-action="Details" asp-route-id="@player.Id">@player.Nickname</a></li>}</ul><a asp-action="Index">Back</a>
