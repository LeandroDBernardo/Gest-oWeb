@model IEnumerable<eSportsMVCv1.Models.Campeonato>
@{ ViewData["Title"] = "Championships"; }
<h1>Championships</h1><p><a asp-action="Create" class="btn btn-primary">Create championship</a> | <a asp-controller="Torneio" asp-action="Index">Tournaments</a></p><table class="table"><thead><tr><th>Name</th><th>Year</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Ano</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>
