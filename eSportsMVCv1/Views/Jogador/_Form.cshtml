@model eSportsMVCv1.Models.Jogador
<div class="mb-3"><label asp-for="EquipaId" class="form-label">Team</label><select asp-for="EquipaId" class="form-select" asp-items="@(new SelectList(ViewBag.Equipas, "Id", "Nome"))"><option value="">Select a team</option></select><span asp-validation-for="EquipaId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Nickname" class="form-label"></label><input asp-for="Nickname" class="form-control" /><span asp-validation-for="Nickname" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Idade" class="form-label"></label><input asp-for="Idade" class="form-control" /><span asp-validation-for="Idade" class="text-danger"></span></div>
