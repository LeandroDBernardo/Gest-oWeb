@model IEnumerable<eSportsMVCv1.Models.Jogador>
@{ ViewData["Title"] = "Players"; }
<h1>Players</h1><form method="get" class="mb-3"><input name="nickname" value="@ViewBag.Nickname" placeholder="Search nickname" class="form-control d-inline-block w-auto" /><button class="btn btn-secondary">Search</button></form><p><a asp-action="Create" class="btn btn-primary">Create player</a></p><table class="table"><thead><tr><th>Name</th><th>Nickname</th><th>Age</th><th>Team</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Nickname</td><td>@item.Idade</td><td>@item.Equipa?.Nome</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>
