@model eSportsMVCv1.Models.PartidaFormViewModel
@{ ViewData["Title"] = "Record result"; }
<h1>Record result</h1>
<form asp-action="Result" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="ResultadoA" class="form-label">Team A result</label><input asp-for="ResultadoA" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ResultadoB" class="form-label">Team B result</label><input asp-for="ResultadoB" class="form-control" /></div>
    <button class="btn btn-primary">Save result</button> <a asp-action="Index" asp-route-torneioId="@Model.TorneioId">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
