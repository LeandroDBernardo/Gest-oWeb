@model IEnumerable<eSportsMVCv1.Models.Partida>
@{ ViewData["Title"] = "Matches"; }
<h1>Matches</h1><form method="get" class="row g-2 mb-3"><div class="col"><input name="jogo" value="@ViewBag.Jogo" placeholder="Game" class="form-control" /></div><div class="col"><select name="estado" class="form-select"><option value="">All states</option>@foreach (var value in Enum.GetValues<eSportsMVCv1.Models.EstadoPartida>()) { <option value="@value">@value</option>}</select></div><div class="col"><button class="btn btn-secondary">Filter</button></div></form>@if (User.IsInRole("Administrator")) { <p><a asp-action="Create" asp-route-torneioId="@ViewBag.TorneioId" class="btn btn-primary">Schedule match</a></p> }<table class="table"><thead><tr><th>Date</th><th>Tournament</th><th>Teams</th><th>Result</th><th>State</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Data</td><td>@item.Torneio?.Nome</td><td>@item.EquipaA?.Nome vs @item.EquipaB?.Nome</td><td>@(item.ResultadoA?.ToString() ?? "-") - @(item.ResultadoB?.ToString() ?? "-")</td><td>@item.Estado</td><td>@if (User.IsInRole("Administrator")) { <a asp-action="Result" asp-route-id="@item.Id">Result</a> }</td></tr>}</tbody></table>
