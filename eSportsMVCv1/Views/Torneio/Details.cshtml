@model eSportsMVCv1.Models.Torneio
@{ ViewData["Title"] = "Tournament details"; }
<h1>@Model.Nome</h1><dl class="row"><dt class="col-sm-3">Game</dt><dd class="col-sm-9">@Model.Jogo</dd><dt class="col-sm-3">Championship</dt><dd class="col-sm-9">@Model.Campeonato?.Nome</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Estado</dd></dl><h2>Teams (@Model.Equipas.Count)</h2><ul>@foreach (var equipa in Model.Equipas) { <li><a asp-controller="Equipa" asp-action="Details" asp-route-id="@equipa.Id">@equipa.Nome</a>@if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Administrator") || equipa.GestorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) && Model.Estado == eSportsMVCv1.Models.EstadoTorneio.Aberto) { <form asp-action="Withdraw" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="equipaId" value="@equipa.Id" /><button class="btn btn-link btn-sm">Withdraw</button></form> }</li>}</ul>@if (Model.Estado == eSportsMVCv1.Models.EstadoTorneio.Aberto && User.Identity?.IsAuthenticated == true && ViewBag.AvailableTeams is IEnumerable<eSportsMVCv1.Models.Equipa> availableTeams && availableTeams.Any()) { <form asp-action="Enroll" method="post" class="mb-3"><input type="hidden" name="id" value="@Model.Id" /><select name="equipaId" class="form-select d-inline-block w-auto">@foreach (var team in availableTeams) { <option value="@team.Id">@team.Nome</option>}</select><button class="btn btn-primary">Enroll team</button></form> } @if (User.IsInRole("Administrator")) { <form asp-action="Start" method="post" class="mb-2"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success">Start tournament</button></form> }<a asp-controller="Partida" asp-action="Index" asp-route-torneioId="@Model.Id">Matches</a> | <a asp-action="Index">Back</a>
