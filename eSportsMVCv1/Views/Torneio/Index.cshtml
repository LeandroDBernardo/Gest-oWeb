@model IEnumerable<eSportsMVCv1.Models.Torneio>
@{ ViewData["Title"] = "Tournaments"; }
<h1>Tournaments</h1><form method="get" class="row g-2 mb-3"><div class="col"><input name="jogo" value="@ViewBag.Jogo" placeholder="Game" class="form-control" /></div><div class="col"><input name="ano" value="@ViewBag.Ano" placeholder="Year" class="form-control" /></div><div class="col"><select name="estado" class="form-select"><option value="">All states</option>@foreach (var value in Enum.GetValues<eSportsMVCv1.Models.EstadoTorneio>()) { <option value="@value">@value</option>}</select></div><div class="col"><button class="btn btn-secondary">Filter</button></div></form><p><a asp-action="Create" class="btn btn-primary">Create tournament</a></p><table class="table"><thead><tr><th>Name</th><th>Game</th><th>Championship</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Jogo</td><td>@item.Campeonato?.Nome</td><td>@item.Estado</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-controller="Statistics" asp-action="Standings" asp-route-id="@item.Id">Standings</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>
